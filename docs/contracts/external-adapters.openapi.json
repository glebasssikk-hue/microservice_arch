{
  "openapi": "3.1.0",
  "info": {
    "title": "DriveNow — требования к внешним адаптерам и симуляторам",
    "version": "1.0.0",
    "description": "Проектируемые интерфейсы; не документация реального банка. Поставщик обязан обеспечить описанные семантические гарантии."
  },
  "servers": [
    {
      "url": "https://provider-adapter.example"
    }
  ],
  "security": [
    {
      "serviceAuth": []
    }
  ],
  "paths": {
    "/holds/{operationId}": {
      "parameters": [
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "ensureHold",
        "description": "Идемпотентный холд. Повтор с другим телом — 409. Терминально снятый ключ не открывается повторно.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результат; PENDING/UNKNOWN требует сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResult"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт параметров либо состояния",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Недоступно; эффект мог выполниться",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getHold",
        "description": "Поиск по исходному ключу. Неизвестный результат — UNKNOWN; отсутствие записи не считается отказом отправленного запроса.",
        "responses": {
          "200": {
            "description": "Результат; PENDING/UNKNOWN требует сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResult"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт параметров либо состояния",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Недоступно; эффект мог выполниться",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/holds/{operationId}/release": {
      "parameters": [
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "releaseHold",
        "description": "Обеспечить RELEASED, включая отсутствие. Сохраняет tombstone, запрещающий поздний PUT; если операция выполняется, результат PENDING до сверки.",
        "responses": {
          "200": {
            "description": "Результат; PENDING/UNKNOWN требует сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResult"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт параметров либо состояния",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Недоступно; эффект мог выполниться",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/access-sessions/{sessionId}": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "ensureAccess",
        "description": "Идемпотентная выдача. Проверяет epoch и validUntil при исполнении. CLOSED терминален. GRANTED означает подтверждённый действующий доступ, не просто приём команды.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результат; PENDING/UNKNOWN требует сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessResult"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт параметров либо состояния",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Недоступно; эффект мог выполниться",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getAccess",
        "description": "Устойчивый результат исходной сессии и состояние движения; UNKNOWN при невозможности подтвердить.",
        "responses": {
          "200": {
            "description": "Результат; PENDING/UNKNOWN требует сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessResult"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт параметров либо состояния",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Недоступно; эффект мог выполниться",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/access-sessions/{sessionId}/revoke": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "revokeAccess",
        "description": "Терминальный отзыв с tombstone. CLOSED только когда нет действующего доступа и поздний PUT невозможен. Если машина движется, 409; двигатель удалённо не глушится.",
        "responses": {
          "200": {
            "description": "Результат; PENDING/UNKNOWN требует сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessResult"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт параметров либо состояния",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Недоступно; эффект мог выполниться",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HoldRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paymentMethodToken": {
            "type": "string"
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        },
        "required": [
          "paymentMethodToken",
          "amountMinor",
          "currency"
        ]
      },
      "HoldResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "HELD",
              "RELEASED",
              "REJECTED",
              "UNKNOWN"
            ]
          },
          "holdId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "operationId",
          "state"
        ]
      },
      "GrantRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "allocationId": {
            "type": "string",
            "format": "uuid"
          },
          "allocationEpoch": {
            "type": "integer",
            "minimum": 1
          },
          "holdId": {
            "type": "string"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "vehicleId",
          "allocationId",
          "allocationEpoch",
          "holdId",
          "validUntil"
        ]
      },
      "AccessResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "GRANTED",
              "CLOSED",
              "UNKNOWN"
            ]
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceAt": {
            "type": "string",
            "format": "date-time"
          },
          "isMoving": {
            "type": "boolean"
          }
        },
        "required": [
          "sessionId",
          "state"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "traceId"
        ]
      }
    }
  }
}
