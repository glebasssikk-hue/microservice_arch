{
  "openapi": "3.1.0",
  "info": {
    "title": "DriveNow — клиентские API",
    "version": "1.0.0",
    "description": "Срез запуска аренды. Сумма депозита определяется сервером. Серверы .example — обозначения, не действующие адреса."
  },
  "servers": [
    {
      "url": "https://rental.drivenow.example"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/rentals": {
      "post": {
        "operationId": "createRental",
        "summary": "Начать распределённый запуск аренды",
        "description": "userId из JWT sub. Повтор ключа с тем же телом возвращает исходный 202 и тот же rentalId. Иное тело — 409. При потере ответа повторить тот же ключ. Возврат 202 не означает выдачу доступа.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRental"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Запрос устойчиво принят",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL состояния аренды",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "400": {
            "description": "Неверный формат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Нет валидного JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Нет допуска",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Не найдено или чужая аренда",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт состояния или ключа",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Перегрузка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Сервис не принимает новые операции",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rentals/{rentalId}": {
      "get": {
        "operationId": "getRental",
        "summary": "Получить состояние своей аренды",
        "parameters": [
          {
            "name": "rentalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Текущее состояние",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rental"
                }
              }
            }
          },
          "401": {
            "description": "Нет валидного JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Не найдено или чужая аренда",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Сервис не принимает новые операции",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/vehicles": {
      "servers": [
        {
          "url": "https://fleet.drivenow.example"
        }
      ],
      "get": {
        "operationId": "listVehicles",
        "summary": "Каталог; доступность не гарантирует успешный резерв",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница каталога",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Vehicle"
                      }
                    },
                    "nextCursor": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Нет валидного JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Сервис не принимает новые операции",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "traceId"
        ]
      },
      "Rental": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rentalId": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "STARTING",
              "ACTIVE",
              "CANCELLING",
              "CANCELLED",
              "MANUAL_REVIEW"
            ]
          },
          "step": {
            "type": "string",
            "enum": [
              "RESERVING",
              "HOLDING",
              "GRANTING",
              "REVOKING",
              "RELEASING_HOLD",
              "RELEASING_VEHICLE",
              "DONE"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "failureCode": {
            "type": "string"
          }
        },
        "required": [
          "rentalId",
          "vehicleId",
          "state",
          "step",
          "createdAt"
        ]
      },
      "CreateRental": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentMethodToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "vehicleId",
          "paymentMethodToken"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rentalId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "STARTING",
              "ACTIVE",
              "CANCELLING",
              "CANCELLED",
              "MANUAL_REVIEW"
            ]
          }
        },
        "required": [
          "rentalId",
          "state"
        ]
      },
      "Vehicle": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "ALLOCATED",
              "OUT_OF_SERVICE"
            ]
          }
        },
        "required": [
          "vehicleId",
          "model",
          "status"
        ]
      }
    }
  }
}
